{
  "manifest_version": 3,
  "name": "console-colorize",
  "description": "Change the GCP console header color per project",
  "author": "Yuki Hosokawa (based on gcp-console-colorize by Yuki Furuyama)",
  "version": "1.9",
  "icons": {
    "16": "icon/icon_16x16.png",
    "48": "icon/icon_48x48.png",
    "128": "icon/icon_128x128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.cloud.google.com/*",
        "https://console.cloud.google/*"
      ],
      "js": ["main.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "storage",
    "webNavigation"
  ]
}
